# ========================================================
# Frontend Environment Variables (.env)
# ========================================================
# In browser-based JavaScript, environment variables are loaded
# through "frontend/js/env.js".
#
# When deploying to Railway:
# 1. Copy your Railway public domain
# 2. Paste it into API_BASE_URL in "frontend/js/env.js"
# ========================================================

API_BASE_URL=https://your-railway-app.up.railway.app
NODE_ENV=production
APP_NAME=FB Connect
